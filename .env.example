AI_PROVIDER=groq
GROQ_API_KEY=your_groq_key_here
GROQ_MODEL=llama-3.1-8b-instant
LLM_VERIFY_SSL=false

# Session auth. If JWT_SECRET is left unset, the server generates one on
# first run and writes it into .env so sessions survive restarts.
JWT_SECRET=
JWT_SESSION_TTL_SECONDS=28800
# Set to true once the app is served over HTTPS (e.g. behind a TLS-terminating
# reverse proxy) so the session cookie gets the Secure flag. Leave false for
# local/plain-HTTP dev, otherwise the browser won't send the cookie back.
COOKIE_SECURE=false
# For local/OpenAI-compatible servers:
# AI_PROVIDER=local
# LLM_BASE_URL=http://localhost:11434/v1
# LLM_MODEL=llama3.1
# LLM_API_KEY=optional
# HTTP_USER_AGENT=InternTracker/0.7
